        --outfit: 'Outfit', system-ui, sans-serif;
        --inter: 'Inter', system-ui, sans-serif;
        --mono: 'JetBrains Mono', monospace;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        margin: 0; width: 1080px; height: 1920px;
        overflow: hidden; background: var(--bg);
      }
      .clip {
        position: absolute; inset: 0; width: 1080px; height: 1920px;
        display: flex; z-index: 1;
      }

      /* Shared scene layouts */
      .lower-third {
        align-items: flex-end; padding: 0 80px 220px 80px;
      }
      .lower-third .block { width: 100%; }
      .centered {
        align-items: center; justify-content: center; padding: 0 80px;
      }
      .centered .block { width: 100%; text-align: center; }
      .left-center {
        align-items: center; padding: 0 80px;
      }
      .left-center .block { width: 100%; }
      .cta-layout {
        flex-direction: column; align-items: center; justify-content: center;
        gap: 44px; padding: 0 80px;
      }

      /* Typography */
      .accent-line {
        width: 56px; height: 2px; background: var(--saude);
        margin-bottom: 32px; opacity: 0;
      }
      .head {
        font-family: var(--outfit); font-size: 58px; font-weight: 700;
        color: var(--paper); letter-spacing: -0.03em; line-height: 1.1; opacity: 0;
      }
      .head-accent {
        font-family: var(--outfit); font-size: 58px; font-weight: 700;
        color: var(--saude); letter-spacing: -0.03em; line-height: 1.1; opacity: 0;
      }
      .head-lg {
        font-family: var(--outfit); font-size: 64px; font-weight: 700;
        color: var(--paper); letter-spacing: -0.03em; line-height: 1.08; opacity: 0;
      }
      .head-lg-accent {
        font-family: var(--outfit); font-size: 64px; font-weight: 700;
        color: var(--saude); letter-spacing: -0.03em; line-height: 1.08; opacity: 0;
      }
      .sub {
        font-family: var(--inter); font-size: 30px; font-weight: 400;
        color: var(--paper-55); line-height: 1.45; margin-top: 20px; opacity: 0;
      }
      .label {
        font-family: var(--mono); font-size: 12px; font-weight: 500;
        letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--saude); margin-bottom: 24px; opacity: 0;
      }
      .feature-title {
        font-family: var(--outfit); font-size: 56px; font-weight: 700;
        color: var(--paper); letter-spacing: -0.03em; line-height: 1.1; opacity: 0;
      }
      .feature-desc {
        font-family: var(--inter); font-size: 30px; font-weight: 400;
        color: var(--paper-55); line-height: 1.45; margin-top: 20px; opacity: 0;
      }
      .feature-highlight {
        font-family: var(--outfit); font-size: 30px; font-weight: 700;
        color: var(--saude); margin-top: 24px; opacity: 0;
      }

      /* CTA */
      .lockup {
        display: flex; align-items: center; gap: 14px; opacity: 0;
      }
      .lockup-word {
        font-family: var(--outfit); font-size: 52px; font-weight: 800;
        color: var(--paper); letter-spacing: -0.04em; line-height: 1;
      }
      .lockup-pipe {
        font-family: var(--outfit); font-size: 52px; font-weight: 300;
        color: var(--paper-35); line-height: 1; margin: 0 2px;
      }
      .lockup-vert {
        font-family: var(--outfit); font-size: 52px; font-weight: 800;
        color: var(--saude); letter-spacing: -0.04em; line-height: 1;
      }
      .cta-pill {
        display: flex; align-items: center; justify-content: center;
        width: 760px; height: 80px;
        background: var(--saude); color: var(--bg);
        font-family: var(--inter); font-size: 26px; font-weight: 700;
        border-radius: 4px; opacity: 0;
      }
      .cta-sub {
        font-family: var(--inter); font-size: 28px; font-weight: 400;
        color: var(--paper-55); text-align: center; opacity: 0;
      }
      .cta-url {
        font-family: var(--mono); font-size: 13px; font-weight: 400;
        color: var(--paper-55); letter-spacing: 0.06em; opacity: 0;
      }

      /* Watermark */
      .watermark {
        position: absolute; top: 60px; left: 80px; z-index: 10;
        display: flex; align-items: center; gap: 8px; opacity: 0.25;
      }
      .wm-text {
        font-family: var(--outfit); font-size: 14px; font-weight: 800;
        color: var(--paper); letter-spacing: -0.03em; line-height: 1;
      }
      .wm-pipe {
