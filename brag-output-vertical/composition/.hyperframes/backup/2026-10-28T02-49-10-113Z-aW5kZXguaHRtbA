    <style>
      :root {
        --bg: #071a19;
        --forest: #0F2A1F;
        --paper: #f6f4ef;
        --saude: #14B8A6;
        --leaf: #4ade80;
        --paper-70: rgba(246,244,239,0.7);
        --paper-55: rgba(246,244,239,0.55);
        --paper-35: rgba(246,244,239,0.35);
        --paper-12: rgba(246,244,239,0.12);
        --paper-06: rgba(246,244,239,0.06);
        --saude-15: rgba(20,184,166,0.15);
        --saude-08: rgba(20,184,166,0.08);
        --outfit: 'Outfit', system-ui, sans-serif;
        --inter: 'Inter', system-ui, sans-serif;
        --mono: 'JetBrains Mono', monospace;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        margin: 0; width: 1080px; height: 1920px;
        overflow: hidden; background: var(--bg);
      }

      .clip {
        position: absolute; inset: 0; width: 1080px; height: 1920px;
        display: flex; z-index: 1;
      }

      /* ============================
         SCENE 1 — Hook
         Left-aligned, lower-third area
      ============================ */
      #s1 {
        align-items: flex-end;
        padding: 0 80px 220px 80px;
      }
      #s1 .block { width: 100%; }
      .s1-line {
        width: 56px; height: 2px; background: var(--saude);
        margin-bottom: 32px; opacity: 0;
      }
      .s1-head {
        font-family: var(--outfit); font-size: 58px; font-weight: 700;
        color: var(--paper); letter-spacing: -0.03em; line-height: 1.1;
        opacity: 0;
      }
      .s1-head-accent {
        font-family: var(--outfit); font-size: 58px; font-weight: 700;
        color: var(--saude); letter-spacing: -0.03em; line-height: 1.1;
        margin-top: 12px; opacity: 0;
      }

      /* ============================
         SCENE 2 — Stats
         Each stat is a full-width row: huge number left, label right
         Stacked vertically with subtle dividers
      ============================ */
      #s2 {
        align-items: center; justify-content: center;
        padding: 0 80px;
      }
      .s2-card {
        width: 100%; border-radius: 8px;
        border: 1px solid var(--saude-15);
        background: rgba(15,42,31,0.4);
        opacity: 0;
      }
      .s2-row {
        display: flex; align-items: center;
        padding: 44px 48px; gap: 40px;
        opacity: 0;
      }
      .s2-row + .s2-row { border-top: 1px solid var(--paper-06); }
      .s2-num {
        font-family: var(--outfit); font-size: 84px; font-weight: 800;
        color: var(--saude); letter-spacing: -0.05em; line-height: 0.9;
        flex-shrink: 0; min-width: 180px; text-align: right;
      }
      .s2-label {
        font-family: var(--inter); font-size: 28px; font-weight: 600;
        color: var(--paper); line-height: 1.3;
      }

      /* ============================
         SCENE 3 — Problem
         Manifesto style: bold statement + sub
         Left-aligned, vertically centered
      ============================ */
      #s3 {
        align-items: center;
        padding: 0 80px;
      }
      #s3 .block { width: 100%; }
      .s3-line {
        width: 56px; height: 2px; background: var(--saude);
        margin-bottom: 36px; opacity: 0;
      }
      .s3-head {
        font-family: var(--outfit); font-size: 64px; font-weight: 700;
        color: var(--paper); letter-spacing: -0.03em; line-height: 1.08;
        opacity: 0;
      }
      .s3-sub {
        font-family: var(--inter); font-size: 28px; font-weight: 400;
        color: var(--paper-55); line-height: 1.5;
        margin-top: 16px; opacity: 0;
      }
      .s3-punch {
        font-family: var(--outfit); font-size: 64px; font-weight: 700;
        color: var(--saude); letter-spacing: -0.03em; line-height: 1.08;
        margin-top: 40px; opacity: 0;
      }

      /* ============================
         SCENE 4 — Solution
         Centered, dramatic
      ============================ */
      #s4 {
        align-items: center; justify-content: center;
        padding: 0 80px;
      }
      .s4-text {
        font-family: var(--outfit); font-size: 56px; font-weight: 700;
        color: var(--paper); letter-spacing: -0.03em; line-height: 1.15;
        text-align: center; opacity: 0;
      }
      .s4-text .accent { color: var(--saude); }

      /* ============================
         SCENE 5 — How it works
         Section label top, left-aligned items with dot markers
      ============================ */
      #s5 {
        align-items: center;
        padding: 0 80px;
      }
      #s5 .block { width: 100%; }
      .s5-label {
        font-family: var(--mono); font-size: 12px; font-weight: 500;
        letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--saude); margin-bottom: 24px; opacity: 0;
      }
      .s5-title {
        font-family: var(--outfit); font-size: 48px; font-weight: 700;
        color: var(--paper); letter-spacing: -0.03em; line-height: 1.12;
        margin-bottom: 40px; opacity: 0;
      }
      .s5-item {
        display: flex; align-items: flex-start; gap: 20px;
        margin-bottom: 28px; opacity: 0;
      }
      .s5-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--saude); flex-shrink: 0; margin-top: 16px;
      }
      .s5-item-text {
        font-family: var(--inter); font-size: 36px; font-weight: 500;
        color: var(--paper-70); line-height: 1.35;
      }
      .s5-item-text--accent { color: var(--saude); font-weight: 600; }

      /* ============================
         SCENE 6 — Benefits
         Centered, large outfit, spaced vertically
      ============================ */
      #s6 {
        flex-direction: column;
        align-items: center; justify-content: center;
        gap: 48px;
        padding: 0 80px;
      }
      .s6-line {
        font-family: var(--outfit); font-size: 52px; font-weight: 700;
        letter-spacing: -0.03em; line-height: 1.1;
        text-align: center; opacity: 0;
      }
      .s6-line--accent { color: var(--saude); }
      .s6-line--paper { color: var(--paper); }

      /* ============================
         SCENE 7 — CTA
         Logo lockup + pill CTA + url
      ============================ */
      #s7 {
        flex-direction: column;
        align-items: center; justify-content: center;
        gap: 44px;
        padding: 0 80px;
      }
      .s7-lockup {
        display: flex; align-items: center; gap: 14px; opacity: 0;
      }
      .s7-word {
        font-family: var(--outfit); font-size: 52px; font-weight: 800;
        color: var(--paper); letter-spacing: -0.04em; line-height: 1;
      }
      .s7-pipe {
        font-family: var(--outfit); font-size: 52px; font-weight: 300;
        color: var(--paper-35); line-height: 1; margin: 0 2px;
      }
      .s7-vert {
        font-family: var(--outfit); font-size: 52px; font-weight: 800;
        color: var(--saude); letter-spacing: -0.04em; line-height: 1;
      }
      .s7-cta {
        display: flex; align-items: center; justify-content: center;
        width: 760px; height: 80px;
        background: var(--saude); color: var(--bg);
        font-family: var(--inter); font-size: 26px; font-weight: 700;
        border-radius: 4px; opacity: 0;
      }
      .s7-url {
        font-family: var(--mono); font-size: 13px; font-weight: 400;
        color: var(--paper-55); letter-spacing: 0.06em; opacity: 0;
      }

      /* Watermark — tiny logo top-left on every scene */
      .watermark {
        position: absolute; top: 60px; left: 80px; z-index: 10;
        display: flex; align-items: center; gap: 8px;
        opacity: 0.25;
      }
      .wm-text {
        font-family: var(--outfit); font-size: 14px; font-weight: 800;
